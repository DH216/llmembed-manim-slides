# Cấu hình môi trường cho Manim Slides
# (Đổi tên thành .env nếu muốn lưu cấu hình cá nhân)

# Font chữ mặc định hiển thị tiếng Việt (nếu cần đổi font khác)
MANIM_FONT=Arial

# Chất lượng render mặc định (-ql: low, -qm: medium, -qh: high, -qk: 4k)
MANIM_DEFAULT_QUALITY=-ql

# Thư mục lưu media kết xuất
MANIM_MEDIA_DIR=./media
